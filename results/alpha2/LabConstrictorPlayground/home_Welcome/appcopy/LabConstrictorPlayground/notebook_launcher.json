{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "LabConstrictorPlayground",
  "menu_items": [
    {
      "name": "LabConstrictorPlayground",
      "description": "Launch LabConstrictorPlayground in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/LabConstrictorPlayground/launch_jupyter.py",
        "{{ PREFIX }}/LabConstrictorPlayground/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "/home/user/apps/Playground/LabConstrictorPlayground/labconstrictor_playground.ico"
        },
        "linux": {
          "icon": "/home/user/apps/Playground/LabConstrictorPlayground/labconstrictor_playground.png"
        },
        "osx": {
          "icon": "/home/user/apps/Playground/LabConstrictorPlayground/labconstrictor_playground.icns"
        }
      }
    }
  ]
}
