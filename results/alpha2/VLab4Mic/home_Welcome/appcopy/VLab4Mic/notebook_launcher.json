{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "VLab4Mic",
  "menu_items": [
    {
      "name": "VLab4Mic",
      "description": "Launch VLab4Mic in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/VLab4Mic/launch_jupyter.py",
        "{{ PREFIX }}/VLab4Mic/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "/home/user/apps/VLab4Mic/VLab4Mic/vlab4mic_icon.ico"
        },
        "linux": {
          "icon": "/home/user/apps/VLab4Mic/VLab4Mic/vlab4mic_icon.png"
        },
        "osx": {
          "icon": "/home/user/apps/VLab4Mic/VLab4Mic/vlab4mic_icon.icns"
        }
      }
    }
  ]
}
