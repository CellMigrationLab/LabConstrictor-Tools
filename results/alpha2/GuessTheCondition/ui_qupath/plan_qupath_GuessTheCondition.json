      "expect": {
        "max_seconds": 120,
        "results": {
          "values": {
            "image": "2 of 3"
          }
        }
      }
    },
    {
      "tool": "play_round",
      "inputs": {
        "results_folder": "fixtures/results",
        "user_name": "Ana",
        "guess": "Nonsense"
