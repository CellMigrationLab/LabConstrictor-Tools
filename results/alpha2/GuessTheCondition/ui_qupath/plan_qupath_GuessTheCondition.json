        "max_seconds": 120,
        "results": {
          "values": {
            "image": "3 of 3"
          }
        }
      }
    },
    {
      "tool": "play_round",
      "inputs": {
        "results_folder": "fixtures/results",
        "user_name": "Ana",
        "guess": "Control"
      },
      "comment": "the last guess is saved and the game says it is over",
