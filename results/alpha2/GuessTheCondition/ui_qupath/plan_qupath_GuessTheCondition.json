        "max_seconds": 120,
        "results": {
          "values": {
            "forgotten_guess": "Control",
            "guessed": 0
          }
        }
      }
    },
    {
      "tool": "play_round",
      "inputs": {
        "results_folder": "fixtures/results",
        "user_name": "Ana",
        "guess": "2"
      },
      "comment": "a guess by number; the image undone before is guessed now",
      "expect": {
        "max_seconds": 120,
        "results": {
          "values": {
            "image": "2 of 3"
          }
        }
      }
    },
    {
      "tool": "play_round",
      "inputs": {
        "results_folder": "fixtures/results",
        "user_name": "Ana",
        "guess": "mutant"
