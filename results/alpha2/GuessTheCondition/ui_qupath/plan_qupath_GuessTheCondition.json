        }
      }
    },
    {
      "tool": "prepare_game",
      "inputs": {
        "experiment_folder": "fixtures/experiment",
        "results_folder": "fixtures/results",
        "user_name": "Ana",
        "percentage_to_test": 100
      },
      "comment": "resuming keeps the guesses and takes the new percentage",
      "expect": {
        "max_seconds": 120,
        "results": {
          "values": {
            "guessed": 3,
