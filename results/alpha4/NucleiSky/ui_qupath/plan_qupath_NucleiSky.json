{
  "app": "NucleiSky",
  "python": "/home/user/apps/NucleiSky/bin/python",
  "tools": [
    {
      "id": "list_devices",
      "label": "List the devices",
      "inputs": [],
      "outputs": [
        {
          "name": "values",
          "type": "values"
        }
      ],
      "description": "The options of the `device` dropdown of the segmentation: the devices PyTorch can use on this machine."
    },
    {
      "id": "relocalize",
      "label": "Relocalize 2D",
      "inputs": [
        {
          "name": "reference",
          "label": "Reference",
          "required": true,
          "type": "image",
          "axes": "YX",
          "description": "Large / full-field image",
          "group": "Images"
        },
        {
          "name": "query",
          "label": "Query",
          "required": true,
          "type": "image",
          "axes": "YX",
          "description": "Crop to locate inside the reference",
          "group": "Images"
        },
        {
          "name": "reference_pixel_size_um",
          "label": "Reference pixel size um",
          "required": false,
          "type": "float",
          "minimum": 0,
          "unit": "um/px",
          "pixel_size_of": "reference",
          "description": "Required. Filled from the reference image's calibration (length unit needed); type it when the image has none",
          "group": "Images",
          "nullable": true
        },
        {
          "name": "query_pixel_size_um",
          "label": "Query pixel size um",
          "required": false,
          "type": "float",
          "minimum": 0,
          "unit": "um/px",
          "pixel_size_of": "query",
          "description": "Required. Filled from the query image's calibration (length unit needed); type it when the image has none",
          "group": "Images",
          "nullable": true
        },
        {
          "name": "segmentation",
          "label": "Segmentation",
          "required": false,
          "default": "threshold",
          "type": "choice",
          "choices": [
            "threshold",
            "cellpose",
            "instanseg"
          ],
          "description": "Used for every image that has no mask. cellpose / instanseg need the deep-learning packages and download model weights on first use",
          "group": "Segmentation"
        },
        {
          "name": "device",
          "label": "Device",
          "required": false,
          "default": "auto",
          "type": "string",
          "description": "Where cellpose / instanseg run: auto = the GPU when there is one, cpu = never the GPU (use it when the GPU runs out of memory), cuda or mps = that device",
          "group": "Segmentation",
          "choices_from": {
            "tool": "list_devices",
            "depends": [],
            "field": "choices"
          },
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose",
              "instanseg"
            ]
          }
        },
        {
          "name": "matcher",
          "label": "Matcher",
          "required": false,
          "default": "auto",
          "type": "choice",
          "choices": [
            "auto",
            "quad",
            "triangles",
            "graph",
            "hashing"
          ],
          "description": "auto = try the matchers in the order NucleiSky recommends for the number of nuclei until one succeeds; or force one",
          "group": "Matching"
        },
        {
          "name": "reference_mask",
          "label": "Reference mask",
          "required": false,
          "type": "labels",
          "axes": "YX",
          "description": "Existing label image of the reference (same size): skips segmentation of the reference",
          "group": "Images",
          "nullable": true
        },
        {
          "name": "query_mask",
          "label": "Query mask",
          "required": false,
          "type": "labels",
          "axes": "YX",
          "description": "Existing label image of the query (same size): skips segmentation of the query",
          "group": "Images",
          "nullable": true
        },
        {
          "name": "threshold_method",
          "label": "Threshold method",
          "required": false,
          "default": "otsu",
          "type": "choice",
          "choices": [
            "otsu",
            "li",
            "yen",
            "triangle",
            "isodata"
          ],
          "group": "Segmentation",
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "threshold"
            ]
          }
        },
        {
          "name": "blur_sigma",
          "label": "Blur sigma",
          "required": false,
          "default": 1.0,
          "type": "float",
          "minimum": 0,
          "maximum": 5,
          "unit": "px",
          "description": "Gaussian blur before thresholding",
          "group": "Segmentation",
          "widget": "slider",
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "threshold"
            ]
          }
        },
        {
          "name": "min_area_px",
          "label": "Min area",
          "required": false,
          "default": 5,
          "type": "integer",
          "minimum": 0,
          "unit": "px",
          "description": "Objects smaller than this are removed",
          "group": "Segmentation",
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "threshold"
            ]
          }
        },
        {
          "name": "watershed_split",
          "label": "Watershed split",
          "required": false,
          "default": true,
          "type": "boolean",
          "description": "Split touching nuclei with a watershed",
          "group": "Segmentation",
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "threshold"
            ]
          }
        },
        {
          "name": "instanseg_model",
          "label": "InstanSeg model",
          "required": false,
          "default": "brightfield_nuclei",
          "type": "choice",
          "choices": [
            "brightfield_nuclei",
            "fluorescence_nuclei_and_cells"
          ],
          "group": "Segmentation",
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "instanseg"
            ]
          }
        },
        {
          "name": "instanseg_target",
          "label": "InstanSeg target",
          "required": false,
          "default": "nuclei",
          "type": "choice",
          "choices": [
            "nuclei",
            "cells"
          ],
          "group": "Segmentation",
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "instanseg"
            ]
          }
        },
        {
          "name": "instanseg_cleanup_fragments",
          "label": "InstanSeg: clean up fragments",
          "required": false,
          "default": true,
          "type": "boolean",
          "group": "Segmentation",
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "instanseg"
            ]
          }
        },
        {
          "name": "instanseg_mode",
          "label": "InstanSeg mode",
          "required": false,
          "default": "auto",
          "type": "choice",
          "choices": [
            "auto",
            "small",
            "medium"
          ],
          "description": "auto = small images in one piece and big ones tiled; or force one (small image / medium = tiled)",
          "group": "Segmentation",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "instanseg"
            ]
          }
        },
        {
          "name": "instanseg_pixel_size_um",
          "label": "InstanSeg pixel size",
          "required": false,
          "type": "float",
          "minimum": 0,
          "unit": "um/px",
          "description": "Override the pixel size InstanSeg works at; unset = the (rescaled) pixel size of the image",
          "group": "Segmentation",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "instanseg"
            ]
          },
          "nullable": true
        },
        {
          "name": "cellpose_diameter_px",
          "label": "Cellpose diameter",
          "required": false,
          "type": "float",
          "minimum": 0,
          "unit": "px",
          "description": "Expected nucleus diameter; unset = Cellpose estimates it",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          },
          "nullable": true
        },
        {
          "name": "cellpose_flow_threshold",
          "label": "Cellpose flow threshold",
          "required": false,
          "default": 0.4,
          "type": "float",
          "minimum": 0,
          "maximum": 3,
          "description": "Maximum error of the flows of a nucleus: raise it to keep more (less regular) nuclei",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          }
        },
        {
          "name": "cellpose_cellprob_threshold",
          "label": "Cellpose cell probability threshold",
          "required": false,
          "default": 0.0,
          "type": "float",
          "minimum": -6,
          "maximum": 6,
          "description": "Lower it to find more nuclei, raise it to find fewer",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          }
        },
        {
          "name": "cellpose_min_size_px",
          "label": "Cellpose minimum size",
          "required": false,
          "default": 15,
          "type": "integer",
          "minimum": 0,
          "unit": "px",
          "description": "Nuclei smaller than this are removed",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          }
        },
        {
          "name": "cellpose_batch_size",
          "label": "Cellpose batch size",
          "required": false,
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Tiles processed together: raise it for speed, lower it when the GPU runs out of memory",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          }
        },
        {
          "name": "cellpose_tile_size_px",
          "label": "Cellpose tile size",
          "required": false,
          "type": "integer",
          "minimum": 64,
          "unit": "px",
          "description": "Size of the tiles big images are cut into; unset = Cellpose's default",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          },
          "nullable": true
        },
        {
          "name": "cellpose_tile_overlap",
          "label": "Cellpose tile overlap",
          "required": false,
          "type": "float",
          "minimum": 0,
          "maximum": 0.9,
          "description": "Fraction of overlap between tiles; unset = Cellpose's default",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          },
          "nullable": true
        },
        {
          "name": "cellpose_normalize",
          "label": "Cellpose: normalise intensities",
          "required": false,
          "default": true,
          "type": "boolean",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          }
        },
        {
          "name": "cellpose_invert",
          "label": "Cellpose: invert the image",
          "required": false,
          "default": false,
          "type": "boolean",
          "description": "For dark nuclei on a bright background",
          "group": "Cellpose",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "cellpose"
            ]
          }
        },
        {
          "name": "reference_region",
          "label": "Reference region",
          "required": false,
          "type": "labels",
          "axes": "YX",
          "description": "Only use the reference nuclei inside this region (the host fills it from the selection); unset = the whole reference",
          "group": "Images",
          "region_of": "reference",
          "nullable": true
        },
        {
          "name": "query_region",
          "label": "Query region",
          "required": false,
          "type": "labels",
          "axes": "YX",
          "description": "Only use the query nuclei inside this region (the host fills it from the selection); unset = the whole query",
          "group": "Images",
          "region_of": "query",
          "nullable": true
        },
        {
          "name": "peak_distance_px",
          "label": "Peak distance",
          "required": false,
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "unit": "px",
          "description": "Minimum distance between watershed seeds (threshold segmentation)",
          "group": "Fine-tuning",
          "advanced": true,
          "enabled_when": {
            "param": "segmentation",
            "equals": [
              "threshold"
            ]
          }
        },
        {
          "name": "fixed_seed",
          "label": "Fixed seed",
          "required": false,
          "type": "integer",
          "description": "Random seed for reproducible matching; unset = default seed 0",
          "group": "Fine-tuning",
          "advanced": true,
          "nullable": true
        },
        {
          "name": "max_seconds",
          "label": "Time limit",
          "required": false,
          "type": "float",
          "minimum": 1,
          "unit": "s",
          "description": "Time limit for the whole matching; unset = no limit",
          "group": "Fine-tuning",
          "advanced": true,
          "nullable": true
        }
      ],
      "outputs": [
        {
          "name": "alignment",
          "type": "affine",
          "replace": true,
          "display": {
            "apply_to": "query",
            "relative_to": "reference"
          }
        },
        {
          "name": "query_aligned",
          "type": "image",
          "replace": true
        },
        {
          "name": "values",
          "type": "values"
        },
        {
          "name": "reference_nuclei",
          "type": "points",
          "replace": true,
          "display": {
            "apply_to": "reference"
          }
        },
        {
          "name": "query_nuclei",
          "type": "points",
          "replace": true,
          "display": {
            "apply_to": "query"
          }
        },
        {
          "name": "reference_outlines",
          "type": "shapes",
          "replace": true,
          "display": {
            "apply_to": "reference"
          }
        },
        {
          "name": "query_outlines",
          "type": "shapes",
          "replace": true,
          "display": {
            "apply_to": "query"
          }
        }
      ],
      "description": "Find where a rotated / rescaled query image lies in a reference image."
    }
  ],
