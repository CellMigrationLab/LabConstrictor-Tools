{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "CellTracksColab",
  "menu_items": [
    {
      "name": "CellTracksColab",
      "description": "Launch CellTracksColab in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/CellTracksColab/launch_jupyter.py",
        "{{ PREFIX }}/CellTracksColab/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "/home/user/apps/CellTracksColab/CellTracksColab/CellTracksColab_logo.ico"
        },
        "linux": {
          "icon": "/home/user/apps/CellTracksColab/CellTracksColab/CellTracksColab_logo.png"
        },
        "osx": {
          "icon": "/home/user/apps/CellTracksColab/CellTracksColab/CellTracksColab_logo.icns"
        }
      }
    }
  ]
}
