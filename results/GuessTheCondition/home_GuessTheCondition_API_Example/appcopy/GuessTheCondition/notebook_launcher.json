{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "GuessTheCondition",
  "menu_items": [
    {
      "name": "GuessTheCondition",
      "description": "Launch GuessTheCondition in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/GuessTheCondition/launch_jupyter.py",
        "{{ PREFIX }}/GuessTheCondition/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "/home/user/apps/GuessTheCondition/GuessTheCondition/guessthecondition.ico"
        },
        "linux": {
          "icon": "/home/user/apps/GuessTheCondition/GuessTheCondition/guessthecondition.png"
        },
        "osx": {
          "icon": "/home/user/apps/GuessTheCondition/GuessTheCondition/guessthecondition.icns"
        }
      }
    }
  ]
}
