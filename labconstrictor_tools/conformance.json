{
 "conformance": 1,
 "_about": "Rules every host must agree on, as data. Loaded with labconstrictor_tools.conformance.load(); validated by labconstrictor_tools.conformance.validate(). Only rules that are already decided in docs/SPEC_WRONG_SCIENCE.md (section 8) or carried by Tools code are here; a rule marked status 'default' is the spec's working default, not yet confirmed. Gaps (rules that are not decided yet) are listed in docs/CONFORMANCE.md, never invented here. A host test must fail when a key it knows is missing (no silent skip) and report 'unsupported' for a case its host cannot run, never 'pass'.",
 "limits": {
  "results_kept": {
   "value": 20,
   "status": "decided",
   "spec": "3.3",
   "unit": "owned finished result folders"
  },
  "run_records_kept": {
   "value": 50,
   "status": "decided",
   "spec": "3.3",
   "unit": "owned finished run records"
  },
  "form_integer_max": {
   "value": 9007199254740991,
   "status": "decided",
   "spec": "6.1",
   "rule": "an integer form field with no declared Min/Max accepts +-value; beyond it is refused, never clamped"
  },
  "unbounded_float": {
   "value": 1000000000000000.0,
   "status": "decided",
   "spec": "6.1",
   "rule": "a float form field with no declared Min/Max accepts +-value; beyond it is refused, never clamped"
  },
  "choices_debounce_ms": {
   "value": 400,
   "status": "decided",
   "spec": "5.3",
   "note": "delays the new request, never the invalidation"
  },
  "choices_busy_retry_ms": {
   "value": 1500,
   "status": "decided",
   "spec": "5.5",
   "note": "lookups wait while a run is active"
  },
  "worker_close_timeout_s": {
   "value": 10,
   "status": "decided",
   "spec": "5.6",
   "note": "HOST_PARITY K03"
  },
  "lookup_in_flight_max": {
   "value": 1,
   "status": "default",
   "spec": "5.4",
   "note": "per widget (per host window)"
  },
  "lookup_pending_max": {
   "value": 8,
   "status": "default",
   "spec": "5.4",
   "note": "oldest dropped and logged"
  },
  "lookup_timeout_s": {
   "value": 60,
   "status": "default",
   "spec": "5.4"
  }
 },
 "host_internal_codes": [
  "frame_unsupported_transform",
  "selection_mixed_planes",
  "selection_plane_mismatch",
  "target_unavailable"
 ],
 "messages": {
  "number_above_maximum": {
   "template": "'{label}' must be <= {maximum}",
   "spec": "6.2",
   "note": "HOST_PARITY I06 worker templates"
  },
  "number_below_minimum": {
   "template": "'{label}' must be >= {minimum}",
   "spec": "6.2"
  },
  "size_mismatch": {
   "template": "'{name}' is {w} x {h} but '{source}' was exported as {w2} x {h2}; shown at the pixel origin, not aligned",
   "spec": "1.1.7"
  },
  "calibration_required": {
   "template": "'{param}' needs a value: '{of}' has no pixel size. Enter it in um.",
   "spec": "2.3.1"
  },
  "calibration_unknown_tooltip": {
   "template": "not calibrated: '{of}' has no pixel size",
   "spec": "2.2"
  },
  "unit_damaged_warning": {
   "template": "unit text '{unit}' is damaged; enter the pixel size",
   "spec": "2.1.4"
  },
  "pixels_not_square_warning": {
   "template": "pixels are not square",
   "spec": "2.1.5"
  },
  "unit_not_length_warning": {
   "template": "unit '{unit}' is not a length",
   "spec": "2.1.5"
  },
  "target_unavailable": {
   "template": "run {run_id} on '{source}': '{source}' is no longer open; results are in {path}",
   "spec": "4.4",
   "note": "decided text of 4.4: the source is gone; a source that is still open but changed size gets target_changed_size (RUN-07)"
  },
  "target_changed_size": {
   "template": "run {run_id} on '{source}': '{source}' changed size while the tool ran; results are in {path}",
   "spec": "4.4",
   "note": "decided (user, 13 Oct): the source is still open but its data shape is not the exported shape; code is still target_unavailable; never used for a source that is gone (target_unavailable, RUN-04)"
  },
  "refusal_suffix": {
   "template": "(nothing was changed; files are in {path})",
   "spec": "1.4",
   "note": "follows every refusal sentence when files exist"
  },
  "file_input_note": {
   "template": "file input: results are in the file's pixel frame",
   "spec": "1.3",
   "note": "QuPath status"
  }
 },
 "compat": {
  "_about": "docs/PROTOCOL.md, 'Compatibility rules for hosts'. Reference: labconstrictor_tools.compat.check_schema.",
  "min_tools_version": "0.2.0rc1",
  "required_features": [
   "reserved_inputs_v1"
  ],
  "cases": [
   {
    "case": "current",
    "schema": {
     "protocol": 1,
     "tools_version": "0.2.0rc1",
     "features": [
      "reserved_inputs_v1"
     ]
    },
    "expect": "ok"
   },
   {
    "case": "newer release",
    "schema": {
     "protocol": 1,
     "tools_version": "0.3.1",
     "features": [
      "reserved_inputs_v1",
      "later"
     ]
    },
    "expect": "ok"
   },
   {
    "case": "written by Tools 0.1 (no fields)",
    "schema": {
     "protocol": 1
    },
    "expect": "refuse",
    "reason_contains": "too old"
   },
   {
    "case": "feature missing",
    "schema": {
     "protocol": 1,
     "tools_version": "0.2.0",
     "features": [
      "other"
     ]
    },
    "expect": "refuse",
    "reason_contains": "reserved_inputs_v1"
   },
   {
    "case": "below the minimum",
    "schema": {
     "protocol": 1,
     "tools_version": "0.1.9",
     "features": [
      "reserved_inputs_v1"
     ]
    },
    "expect": "refuse",
    "reason_contains": "older than"
   },
   {
    "case": "version not understood",
    "schema": {
     "protocol": 1,
     "tools_version": "banana",
     "features": [
      "reserved_inputs_v1"
     ]
    },
    "expect": "warn"
   },
   {
    "case": "protocol 2",
    "schema": {
     "protocol": 2
    },
    "expect": "refuse",
    "reason_contains": "protocol"
   }
  ],
  "version_order": [
   "0.2.0a1",
   "0.2.0b1",
   "0.2.0rc1",
   "0.2.0",
   "0.2.1",
   "0.3.0a1",
   "0.3.0",
   "0.10.0"
  ]
 },
